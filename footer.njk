---
permalink: /footer.html
---
<div class="footer-container">
    <div class="footer-col">
        <h3>{{ footer.about.heading }}</h3>
        <p>{{ footer.about.text }}</p>
    </div>
    <div class="footer-col">
        <h3>{{ footer.quickLinks.heading }}</h3>
        <ul>
            {% for item in footer.quickLinks.links %}
            <li><a href="{{ item.link }}">{{ item.label }}</a></li>
            {% endfor %}
        </ul>
    </div>
    <div class="footer-col">
        <h3>{{ footer.affiliates.heading }}</h3>
        <ul>
            {% for name in footer.affiliates.items %}
            <li>{{ name }}</li>
            {% endfor %}
        </ul>
    </div>
    <div class="footer-col">
        <h3>{{ footer.connect.heading }}</h3>
        <p>Facebook: {{ footer.connect.facebook }}</p>
        <p>Instagram: {{ footer.connect.instagram }}</p>
        <p>Web: {{ footer.connect.website }}</p>
    </div>
</div>
<div class="footer-bottom">
    <p>&copy; {{ footer.copyright }}</p>
</div>
