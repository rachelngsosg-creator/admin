---
permalink: /header.html
---
<div class="nav-container">
    <a href="./" class="brand" aria-label="Special Olympics Singapore Home">
        <img src="{{ nav.logo }}" alt="Special Olympics Singapore Logo" class="brand-logo-img">
    </a>
    <button class="mobile-toggle" id="mobile-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation menu">
        ☰
    </button>
    <nav id="primary-nav">
        <ul class="nav-menu" id="nav-menu">
            {% for item in nav.menu %}
            <li><a href="{{ item.link }}" class="nav-link">{{ item.label }}</a></li>
            {% endfor %}
        </ul>
    </nav>
</div>
